{#
  Eloria — Blog index
  src/views/pages/blog/index.twig
#}
{% extends 'layouts.master' %}

{% block content %}
<section class="blog">
  <div class="container">
    <header class="page-hero page-hero-center">
      <span class="eyebrow">{{ trans('blog.eyebrow') }}</span>
      <h1 class="section-title">{{ page.title ?? trans('blog.title') }}</h1>
      <p class="page-hero-lead">{{ trans('blog.lead') }}</p>
    </header>

    {% if articles|length %}
      <div class="blog-grid">
        {% for article in articles %}
          <article class="bcard">
            <a class="bcard-media" href="{{ article.url }}">
              {% if article.image %}<img src="{{ article.image }}" alt="{{ article.title }}" loading="lazy">{% else %}<div class="placeholder" data-label="ARTICLE"></div>{% endif %}
            </a>
            <div class="bcard-body">
              <span class="bcard-date">{{ article.created_at|date('Y/m/d') }}</span>
              <h3 class="bcard-title"><a href="{{ article.url }}">{{ article.title }}</a></h3>
              <p class="bcard-excerpt">{{ article.excerpt }}</p>
              <a class="bcard-more" href="{{ article.url }}">{{ trans('blog.read_more') }} ←</a>
            </div>
          </article>
        {% endfor %}
      </div>
      {% if articles.last_page > 1 %}<div class="listing-pagination">{{ articles.links|raw }}</div>{% endif %}
    {% else %}
      <div class="account-empty"><p>{{ trans('blog.empty') }}</p></div>
    {% endif %}
  </div>
</section>
{% endblock %}

{% block scripts %}
  <script src="{{ asset('js/app.js') }}" defer></script>
{% endblock %}
