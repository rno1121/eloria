{#
  Eloria — Blog single
  src/views/pages/blog/single.twig
#}
{% extends 'layouts.master' %}

{% block content %}
<article class="post">
  <div class="container post-container">
    <header class="post-head">
      <a class="post-back" href="{{ url('blog') }}">← {{ trans('blog.title') }}</a>
      <span class="bcard-date">{{ article.created_at|date('Y/m/d') }}</span>
      <h1 class="post-title">{{ article.title }}</h1>
    </header>

    {% if article.image %}
      <div class="post-cover"><img src="{{ article.image }}" alt="{{ article.title }}"></div>
    {% endif %}

    <div class="post-body rich">{{ article.content|raw }}</div>

    <footer class="post-foot">
      <a class="btn btn-ghost" href="{{ url('blog') }}">← {{ trans('blog.title') }}</a>
      <a class="btn btn-primary" href="{{ url('products') }}">{{ trans('home.hero.cta_short') }}</a>
    </footer>
  </div>
</article>
{% endblock %}

{% block scripts %}
  <script src="{{ asset('js/app.js') }}" defer></script>
{% endblock %}
