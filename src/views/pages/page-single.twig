{#
  Eloria — Static page (single)
  src/views/pages/page-single.twig
  للصفحات الثابتة: من نحن، سياسة الإرجاع، الشروط، إلخ.
#}
{% extends 'layouts.master' %}

{% block content %}
<article class="static-page">
  <div class="container static-container">
    <header class="page-hero page-hero-center">
      <span class="eyebrow">{{ store.name }}</span>
      <h1 class="section-title">{{ page.title }}</h1>
    </header>
    <div class="static-body rich">
      {{ page.content|raw }}
    </div>
  </div>
</article>
{% endblock %}

{% block scripts %}
  <script src="{{ asset('js/app.js') }}" defer></script>
{% endblock %}
