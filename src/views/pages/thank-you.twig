{#
  Eloria — Thank you / Order confirmation
  src/views/pages/thank-you.twig
#}
{% extends 'layouts.master' %}

{% block content %}
<section class="thankyou">
  <div class="container thankyou-inner">
    <div class="thankyou-mark" aria-hidden="true">
      <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="24" cy="24" r="22"/><path d="M15 24.5l6 6 12-13"/></svg>
    </div>
    <span class="eyebrow">{{ trans('thankyou.eyebrow') }}</span>
    <h1 class="section-title">{{ trans('thankyou.title') }}</h1>
    <p class="thankyou-lead">{{ trans('thankyou.lead') }}</p>

    {% if order.id %}
      <div class="thankyou-order">
        <div><span>{{ trans('thankyou.order_no') }}</span><strong>#{{ order.id }}</strong></div>
        {% if order.total %}<div><span>{{ trans('thankyou.total') }}</span><strong>{{ order.total|money }}</strong></div>{% endif %}
        {% if order.payment_method %}<div><span>{{ trans('thankyou.payment') }}</span><strong>{{ order.payment_method }}</strong></div>{% endif %}
      </div>
    {% endif %}

    <div class="thankyou-tip">
      <h3>{{ trans('thankyou.tip_title') }}</h3>
      <p>{{ trans('thankyou.tip_body') }}</p>
    </div>

    <div class="thankyou-actions">
      {% if order.id %}<a class="btn btn-primary" href="{{ url('customer.order.single', { id: order.id }) }}">{{ trans('thankyou.track') }}</a>{% endif %}
      <a class="btn btn-ghost" href="{{ store.url }}">{{ trans('thankyou.back') }}</a>
    </div>
  </div>
</section>
{% endblock %}

{% block scripts %}
  <script src="{{ asset('js/app.js') }}" defer></script>
{% endblock %}
