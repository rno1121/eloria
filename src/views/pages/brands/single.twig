{#
  Eloria — Brand single
  src/views/pages/brands/single.twig
#}
{% extends 'layouts.master' %}

{% block content %}
<section class="listing">
  <div class="container">
    <header class="page-hero page-hero-center">
      {% if brand.logo %}<img class="brand-hero-logo" src="{{ brand.logo }}" alt="{{ brand.name }}">{% endif %}
      <span class="eyebrow">{{ trans('brands.eyebrow') }}</span>
      <h1 class="section-title">{{ brand.name }}</h1>
    </header>

    {% if products|length %}
      <div class="product-cards">
        {% for product in products %}
          <article class="pcard">
            <a class="pcard-media" href="{{ product.url }}">
              {% if product.image.url %}<img src="{{ product.image.url }}" alt="{{ product.name }}" loading="lazy">{% else %}<div class="placeholder" data-label="PRODUCT"></div>{% endif %}
              {% if product.on_sale %}<span class="product-flag">{{ trans('product.sale') }}</span>{% endif %}
            </a>
            <div class="pcard-body">
              <h3 class="pcard-name"><a href="{{ product.url }}">{{ product.name }}</a></h3>
              <div class="pcard-foot">
                <div class="pcard-price"><span class="price-now">{{ product.price|money }}</span></div>
                <salla-add-product-button product-id="{{ product.id }}" product-status="{{ product.status }}" product-type="{{ product.type }}" class="pcard-add">{{ trans('listing.add') }}</salla-add-product-button>
              </div>
            </div>
          </article>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>
{% endblock %}

{% block scripts %}
  <script src="{{ asset('js/app.js') }}" defer></script>
{% endblock %}
