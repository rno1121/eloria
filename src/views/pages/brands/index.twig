{#
  Eloria — Brands index
  src/views/pages/brands/index.twig
#}
{% extends 'layouts.master' %}

{% block content %}
<section class="brands">
  <div class="container">
    <header class="page-hero page-hero-center">
      <span class="eyebrow">{{ trans('brands.eyebrow') }}</span>
      <h1 class="section-title">{{ page.title ?? trans('brands.title') }}</h1>
    </header>

    {% if brands|length %}
      <div class="brands-grid">
        {% for brand in brands %}
          <a class="brand-tile" href="{{ brand.url }}">
            {% if brand.logo %}<img src="{{ brand.logo }}" alt="{{ brand.name }}">{% else %}<span class="brand-name">{{ brand.name }}</span>{% endif %}
          </a>
        {% endfor %}
      </div>
    {% else %}
      <div class="account-empty"><p>{{ trans('brands.empty') }}</p></div>
    {% endif %}
  </div>
</section>
{% endblock %}

{% block scripts %}
  <script src="{{ 'app.js' | asset }}" defer></script>
{% endblock %}
