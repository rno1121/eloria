{#
  Eloria — Products listing
  src/views/pages/product/index.twig
#}
{% extends 'layouts.master' %}

{% block content %}
<section class="listing">
  <div class="container">

    <header class="listing-head">
      <span class="eyebrow">{{ trans('nav.shop') }}</span>
      <h1 class="section-title">{{ page.title ?? trans('listing.title') }}</h1>
      <p class="listing-count">{{ products.total ?? products|length }} {{ trans('listing.products') }}</p>
    </header>

    {% hook 'product.index.before_products_group_with_filter' %}
    <salla-filters></salla-filters>

    {% if products|length %}
      <div class="product-cards">
        {% for product in products %}
          <article class="pcard">
            <a class="pcard-media" href="{{ product.url }}">
              {% if product.image.url %}
                <img src="{{ product.image.url }}" alt="{{ product.image.alt ?? product.name }}" loading="lazy">
              {% else %}
                <div class="placeholder" data-label="PRODUCT"></div>
              {% endif %}
              {% if product.on_sale %}<span class="product-flag">{{ trans('product.sale') }}</span>{% endif %}
              <salla-button shape="icon" class="pcard-wish" onclick="salla.wishlist.toggle({{ product.id }})" aria-label="{{ trans('nav.wishlist') }}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M12 20s-7-4.5-9.2-9C1.3 7.6 2.6 4.5 6 4.5c2 0 3.2 1.3 4 2.5.8-1.2 2-2.5 4-2.5 3.4 0 4.7 3.1 3.2 6.5C19 15.5 12 20 12 20z"/></svg>
              </salla-button>
            </a>
            <div class="pcard-body">
              {% if product.brand.name %}<span class="pcard-brand">{{ product.brand.name }}</span>{% endif %}
              <h3 class="pcard-name"><a href="{{ product.url }}">{{ product.name }}</a></h3>
              <div class="pcard-foot">
                <div class="pcard-price">
                  {% if product.on_sale %}
                    {% set discount = ((product.regular_price - product.sale_price) / product.regular_price * 100)|round %}
                    <span class="price-now">{{ product.sale_price|money }}</span>
                    <span class="price-was">{{ product.regular_price|money }}</span>
                    <span class="price-badge">-{{ discount }}%</span>
                  {% else %}
                    <span class="price-now">{{ product.price|money }}</span>
                  {% endif %}
                </div>
                <salla-add-product-button
                  product-id="{{ product.id }}"
                  product-status="{{ product.status }}"
                  product-type="{{ product.type }}"
                  class="pcard-add">
                  {{ trans('listing.add') }}
                </salla-add-product-button>
              </div>
            </div>
          </article>
        {% endfor %}
      </div>

      {% if products.last_page > 1 %}
        <div class="listing-pagination">{{ products.links | raw }}</div>
      {% endif %}

    {% else %}
      <div class="listing-empty">
        <p>{{ trans('listing.empty') }}</p>
        <a class="btn btn-primary" href="{{ store.url }}">{{ trans('nav.home') }}</a>
      </div>
    {% endif %}

    {% hook 'product.index.after_products_group_with_filter' %}
    {% hook 'product.index.after_testimonials' %}

  </div>
</section>
{% endblock %}

{% block scripts %}
  <script src="{{ 'app.js' | asset }}" defer></script>
{% endblock %}
