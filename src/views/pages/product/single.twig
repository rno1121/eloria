{#
  Eloria — Product Single
  src/views/pages/product/single.twig
#}
{% extends 'layouts.master' %}

{% block content %}
<section class="product-single">
  <div class="container">

    {# مسار التنقّل #}
    <nav class="breadcrumb" aria-label="breadcrumb">
      <a href="{{ store.url }}">{{ trans('nav.home') }}</a>
      <span>/</span>
      <a href="{{ url('products') }}">{{ trans('nav.products') }}</a>
      <span>/</span>
      <strong>{{ product.name }}</strong>
    </nav>

    <div class="product-grid">

      {# ===== المعرض ===== #}
      <div class="product-gallery" data-gallery>
        {% if product.on_sale %}<span class="product-flag">{{ trans('product.sale') }}</span>{% endif %}
        <div class="gallery-track" data-gallery-track>
          {% if product.images|length %}
            {% for image in product.images %}
              <div class="gallery-slide"><img src="{{ image.url }}" alt="{{ image.alt ?? product.name }}"></div>
            {% endfor %}
          {% else %}
            <div class="gallery-slide"><div class="placeholder" data-label="PRODUCT SHOT — 50ml"></div></div>
          {% endif %}
        </div>
        {% if product.images|length > 1 %}
          <div class="gallery-dots" data-gallery-dots></div>
          <div class="gallery-thumbs">
            {% for image in product.images %}
              <button class="gallery-thumb {{ loop.first ? 'is-active' : '' }}" data-index="{{ loop.index0 }}">
                <img src="{{ image.url }}" alt="{{ image.alt }}">
              </button>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      {# ===== المعلومات ===== #}
      <div class="product-info">
        {% if product.brand.name %}<span class="product-brand">{{ product.brand.name }}</span>{% endif %}
        <h1 class="product-title">{{ product.name }}</h1>
        {% if product.subtitle %}<p class="product-subtitle">{{ product.subtitle }}</p>{% endif %}

        <div class="product-rating">
          <salla-rating-stars value="{{ product.rating.stars ?? 5 }}"></salla-rating-stars>
          <a href="#reviews">{{ product.rating.count ?? 214 }} {{ trans('product.reviews_count') }}</a>
        </div>

        <div class="product-price">
          {% if product.on_sale %}
            {% set discount = ((product.regular_price - product.sale_price) / product.regular_price * 100)|round %}
            <span class="price-now">{{ product.sale_price|money }}</span>
            <span class="price-was">{{ product.regular_price|money }}</span>
            <span class="price-badge">{{ trans('product.save') }} {{ discount }}%</span>
          {% else %}
            <span class="price-now">{{ product.price|money }}</span>
          {% endif %}
          <small>50ml</small>
        </div>

        {% hook 'product:single.description.start' %}
        <div class="product-short">{{ product.promotion_title ?? trans('product.short') }}</div>
        {% hook 'product:single.description.end' %}

        <ul class="product-badges">
          <li>{{ trans('home.badges.sfda') }}</li>
          <li>{{ trans('home.badges.cortisone') }}</li>
          <li>{{ trans('home.badges.fragrance') }}</li>
          <li>{{ trans('home.badges.alcohol') }}</li>
          <li>{{ trans('home.badges.sensitive') }}</li>
          <li>pH 5–6</li>
        </ul>

        {% hook 'product:single.form.start' %}
        <div class="product-form">
          <salla-add-product-button
            product-id="{{ product.id }}"
            product-status="{{ product.status }}"
            product-type="{{ product.type }}"
            class="btn btn-primary product-add">
            <svg class="btn-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 7h12l-1 13H7L6 7z"/><path d="M9 7a3 3 0 0 1 6 0"/></svg>{{ trans('home.hero.cta_short') }}
          </salla-add-product-button>
          <a class="product-checkout" href="{{ url('cart') }}"><svg class="btn-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="6" width="18" height="13" rx="2.5"/><path d="M3 10h18"/><circle cx="16.5" cy="13.5" r="1.1" fill="currentColor" stroke="none"/></svg>{{ trans('cart.checkout') }}</a>
        </div>
        {% hook 'product:single.form.end' %}

        <ul class="product-assurance">
          <li>{{ trans('product.shipping') }}</li>
          <li>{{ trans('product.secure') }}</li>
          <li>{{ trans('product.made') }}</li>
        </ul>
      </div>
    </div>

    {# ===== المفهوم الأساسي ===== #}
    <div class="product-concept">
      <p>{{ trans('home.concept.headline')|raw }}</p>
    </div>

    {# ===== طريقة الاستخدام ===== #}
    <div class="product-section" id="how">
      <header class="section-head section-head-center">
        <span class="eyebrow">{{ trans('home.how.eyebrow') }}</span>
        <h2 class="section-title">{{ trans('home.how.title') }}</h2>
      </header>
      <ol class="steps">
        <li class="step"><span class="step-num">01</span><h3>{{ trans('home.how.s1_t') }}</h3><p>{{ trans('home.how.s1_d') }}</p></li>
        <li class="step"><span class="step-num">02</span><h3>{{ trans('home.how.s2_t') }}</h3><p>{{ trans('home.how.s2_d') }}</p></li>
        <li class="step"><span class="step-num">03</span><h3>{{ trans('home.how.s3_t') }}</h3><p>{{ trans('home.how.s3_d') }}</p></li>
        <li class="step"><span class="step-num">04</span><h3>{{ trans('home.how.s4_t') }}</h3><p>{{ trans('home.how.s4_d') }}</p></li>
      </ol>
    </div>

    {# ===== المكوّنات ===== #}
    <div class="product-section product-section-tint" id="ingredients">
      <div class="ingredients-grid">
        <div class="ingredients-intro">
          <span class="eyebrow">{{ trans('home.ing.eyebrow') }}</span>
          <h2 class="section-title">{{ trans('home.ing.title') }}</h2>
          <p>{{ trans('home.ing.desc') }}</p>
        </div>
        <ul class="ingredient-list">
          <li><span class="ing-pct">01</span><div><strong>Tranexamic Acid</strong><em>{{ trans('home.ing.tranexamic') }}</em></div></li>
          <li><span class="ing-pct">02</span><div><strong>Niacinamide</strong><em>{{ trans('home.ing.niacinamide') }}</em></div></li>
          <li><span class="ing-pct">03</span><div><strong>Alpha Arbutin</strong><em>{{ trans('home.ing.arbutin') }}</em></div></li>
          <li><span class="ing-pct">04</span><div><strong>Panthenol</strong><em>{{ trans('home.ing.panthenol') }}</em></div></li>
          <li><span class="ing-pct">05</span><div><strong>Hyaluronic Acid</strong><em>{{ trans('home.ing.ha') }}</em></div></li>
          <li><span class="ing-pct">06</span><div><strong>Glycerin</strong><em>{{ trans('home.ing.glycerin') }}</em></div></li>
        </ul>
      </div>
    </div>

    {# ===== الوصف الكامل ===== #}
    {% if product.description %}
      <div class="product-section product-description">
        <h2 class="section-title">{{ trans('product.about') }}</h2>
        <div class="rich">{{ product.description|raw }}</div>
      </div>
    {% endif %}

    {# ===== التقييمات ===== #}
    <div class="product-section" id="reviews">
      <header class="section-head section-head-center">
        <span class="eyebrow">{{ trans('home.reviews.eyebrow') }}</span>
        <h2 class="section-title">{{ trans('home.reviews.title') }}</h2>
      </header>
      <salla-comments comment-type="reviews" data-id="{{ product.id }}"></salla-comments>
    </div>

  </div>
</section>

{# شريط الشراء الثابت — جوال #}
<div class="buybar" data-buybar>
  <div class="buybar-qty">
    <salla-quantity-input product-id="{{ product.id }}" max="{{ product.quantity }}"></salla-quantity-input>
  </div>
  <salla-add-product-button
    product-id="{{ product.id }}"
    product-status="{{ product.status }}"
    product-type="{{ product.type }}"
    class="btn btn-primary buybar-btn buybar-add">
    <svg class="btn-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 7h12l-1 13H7L6 7z"/><path d="M9 7a3 3 0 0 1 6 0"/></svg>{{ trans('home.hero.cta_short') }}
  </salla-add-product-button>
  <a class="buybar-checkout" href="{{ url('cart') }}"><svg class="btn-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="6" width="18" height="13" rx="2.5"/><path d="M3 10h18"/><circle cx="16.5" cy="13.5" r="1.1" fill="currentColor" stroke="none"/></svg>{{ trans('cart.checkout') }}</a>
</div>
{% endblock %}

{% block scripts %}
  <script src="{{ asset('js/app.js') }}" defer></script>
  <script src="{{ asset('js/product.js') }}" defer></script>
{% endblock %}
