{#
  Eloria — Homepage
  src/views/pages/index.twig
#}
{% extends 'layouts.master' %}

{% block content %}

  {# ===== 1. HERO — صورة المنتج كبيرة ===== #}
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">{{ trans('home.hero.eyebrow') }}</span>
        <h1 class="hero-title">{{ trans('home.hero.title') }}</h1>
        <div class="hero-cert">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M8.5 12.2l2.3 2.3 4.7-5"/></svg>
          <span>{{ trans('home.badges.sfda') }}</span>
        </div>
        <p class="hero-sub">{{ trans('home.hero.sub') }}</p>
        <div class="hero-cta">
          <a class="btn btn-primary" href="#order">{{ trans('home.hero.cta_shop') }}</a>
          <a class="btn btn-ghost" href="#routine">{{ trans('home.hero.cta2') }}</a>
        </div>
        <ul class="hero-badges">
          <li>{{ trans('home.badges.cortisone') }}</li>
          <li>{{ trans('home.badges.fragrance') }}</li>
          <li>{{ trans('home.badges.alcohol') }}</li>
          <li>{{ trans('home.badges.sensitive') }}</li>
        </ul>
      </div>

      <div class="hero-visual">
        {% set featured = store.products.featured|first %}
        {% set hero_img = theme.settings.get('hero_image') ?? featured.image.url %}
        <div class="hero-product">
          {% if hero_img %}
            <img src="{{ hero_img }}" alt="{{ trans('home.hero.title') }}">
          {% else %}
            <div class="placeholder placeholder-bottle" data-label="HERO IMAGE"></div>
          {% endif %}
        </div>
        <span class="hero-price-tag">
          {% if featured.on_sale %}
            {% set hd = ((featured.regular_price - featured.sale_price) / featured.regular_price * 100)|round %}
            <span class="hpt-off">{{ trans('product.save') }} {{ hd }}%</span>
            <span class="hpt-was">{{ featured.regular_price|money }}</span>
            <span class="hpt-now">{{ featured.sale_price|money }}</span>
          {% else %}
            <span class="hpt-now">149 <small>{{ trans('common.sar') }}</small></span>
          {% endif %}
        </span>
      </div>
    </div>
  </section>

  {# ===== 2. المفهوم الأساسي — أضيفيه لكريمك ===== #}
  <section class="concept">
    <div class="container">
      <div class="concept-box">
        <p class="concept-line">{{ trans('home.concept.headline')|raw }}</p>
        <p class="concept-sub">{{ trans('home.concept.sub') }}</p>
      </div>
    </div>
  </section>

  {# ===== 4. المكونات الفعّالة ===== #}
  <section class="ingredients" id="ingredients">
    <div class="container ingredients-grid">
      <div class="ingredients-intro">
        <span class="eyebrow">{{ trans('home.ing.eyebrow') }}</span>
        <h2 class="section-title">{{ trans('home.ing.title') }}</h2>
        <p>{{ trans('home.ing.desc') }}</p>
        <p class="ph-meta">pH 5–6 · 50ml</p>
        <button class="ing-toggle" data-ing-toggle aria-expanded="false">
          <span>{{ trans('footer.ingredients') }}</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 15l6-6 6 6"/></svg>
        </button>
      </div>
      <ul class="ingredient-list">
        <li><span class="ing-pct">01</span><div><strong>Tranexamic Acid</strong><em>{{ trans('home.ing.tranexamic') }}</em></div></li>
        <li><span class="ing-pct">02</span><div><strong>Niacinamide</strong><em>{{ trans('home.ing.niacinamide') }}</em></div></li>
        <li><span class="ing-pct">03</span><div><strong>Glutathione</strong><em>{{ trans('home.ing.glutathione') }}</em></div></li>
        <li><span class="ing-pct">04</span><div><strong>Panthenol</strong><em>{{ trans('home.ing.panthenol') }}</em></div></li>
        <li><span class="ing-pct">05</span><div><strong>Glycerin</strong><em>{{ trans('home.ing.glycerin') }}</em></div></li>
        <li><span class="ing-pct">06</span><div><strong>Propylene Glycol</strong><em>{{ trans('home.ing.propylene') }}</em></div></li>
      </ul>
    </div>
  </section>

  {# ===== 5. الفوائد — كاروسيل تلقائي ===== #}
  <section class="benefits">
    <div class="container">
      <div class="benefits-carousel" data-benefits>
        <div class="benefits-track" data-benefits-track>
          <article class="benefit-card">
            <span class="benefit-num">01</span>
            <span class="benefit-ic"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 3c.6 4.5 3.9 7.8 8.4 8.4-4.5.6-7.8 3.9-8.4 8.4-.6-4.5-3.9-7.8-8.4-8.4C8.1 10.8 11.4 7.5 12 3z"/></svg></span>
            <h3>{{ trans('home.ben.b2_t') }}</h3>
            <p>{{ trans('home.ben.b2_d') }}</p>
          </article>
          <article class="benefit-card">
            <span class="benefit-num">02</span>
            <span class="benefit-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3"/></svg></span>
            <h3>{{ trans('home.ben.b1_t') }}</h3>
            <p>{{ trans('home.ben.b1_d') }}</p>
          </article>
          <article class="benefit-card">
            <span class="benefit-num">03</span>
            <span class="benefit-ic"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 3.5c3.4 4.3 5.8 7.3 5.8 10.2a5.8 5.8 0 1 1-11.6 0C6.2 10.8 8.6 7.8 12 3.5z"/></svg></span>
            <h3>{{ trans('home.ben.b3_t') }}</h3>
            <p>{{ trans('home.ben.b3_d') }}</p>
          </article>
          <article class="benefit-card">
            <span class="benefit-num">04</span>
            <span class="benefit-ic"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M5 19c0-7.7 6.3-14 14-14 0 7.7-6.3 14-14 14z"/></svg></span>
            <h3>{{ trans('home.ben.b4_t') }}</h3>
            <p>{{ trans('home.ben.b4_d') }}</p>
          </article>
        </div>
      </div>
      <div class="benefits-dots" data-benefits-dots></div>
    </div>
  </section>
{# === END BENEFITS === #}

  {# ===== 6. أداة جدول العناية التفاعلية ===== #}
  {% include 'components.home.skin-routine-tool' %}

  {# ===== 8. دعوة الشراء النهائية ===== #}
  <section class="final-cta" id="order">
    <div class="container final-cta-inner">
      <div class="final-visual">
        {% set fp = store.products.featured|first %}
        {% set cta_img = theme.settings.get('cta_image') ?? fp.image.url %}
        {% if cta_img %}
          <img src="{{ cta_img }}" alt="{{ trans('home.final.title') }}">
        {% else %}
          <div class="placeholder placeholder-bottle" data-label="CTA IMAGE"></div>
        {% endif %}
      </div>
      <div class="final-copy">
        <h2 class="section-title">{{ trans('home.final.title') }}</h2>
        <p>{{ trans('home.final.desc') }}</p>
        <div class="final-price">
          {% if fp.on_sale %}
            {% set fd = ((fp.regular_price - fp.sale_price) / fp.regular_price * 100)|round %}
            <span>{{ fp.sale_price|money }}</span>
            <span class="price-was">{{ fp.regular_price|money }}</span>
            <span class="price-badge">{{ trans('product.save') }} {{ fd }}%</span>
            <small>50ml</small>
          {% else %}
            <span>149 {{ trans('common.sar') }}</span><small>50ml</small>
          {% endif %}
        </div>
        {% if fp.id %}
          <salla-add-product-button
            product-id="{{ fp.id }}"
            product-status="{{ fp.status }}"
            product-type="{{ fp.type }}"
            class="btn btn-primary btn-block">
            {{ trans('home.hero.cta') }}
          </salla-add-product-button>
        {% else %}
          <a class="btn btn-primary btn-block" href="{{ url('products') }}">{{ trans('home.hero.cta') }}</a>
        {% endif %}
      </div>
    </div>
  </section>

  {# ===== طريقة الاستخدام — 4 خطوات (قبل التقييمات) ===== #}
  <section class="how" id="how-to-use">
    <div class="container">
      <header class="section-head">
        <span class="eyebrow">{{ trans('home.how.eyebrow') }}</span>
        <h2 class="section-title">{{ trans('home.how.title') }}</h2>
      </header>
      <ol class="steps">
        <li class="step">
          <span class="step-num">01</span>
          <h3>{{ trans('home.how.s1_t') }}</h3>
          <p>{{ trans('home.how.s1_d') }}</p>
        </li>
        <li class="step">
          <span class="step-num">02</span>
          <h3>{{ trans('home.how.s2_t') }}</h3>
          <p>{{ trans('home.how.s2_d') }}</p>
        </li>
        <li class="step">
          <span class="step-num">03</span>
          <h3>{{ trans('home.how.s3_t') }}</h3>
          <p>{{ trans('home.how.s3_d') }}</p>
        </li>
        <li class="step">
          <span class="step-num">04</span>
          <h3>{{ trans('home.how.s4_t') }}</h3>
          <p>{{ trans('home.how.s4_d') }}</p>
        </li>
      </ol>
      <div class="steps-dots" data-steps-dots></div>
    </div>
  </section>

  {# ===== آراء العملاء — آخر قسم ===== #}
  <section class="reviews">
    <div class="container">
      <div class="reviews-top">
        <header class="section-head" style="margin-bottom:0;">
          <span class="eyebrow">{{ trans('home.reviews.eyebrow') }}</span>
          <h2 class="section-title">{{ trans('home.reviews.title') }}</h2>
        </header>
        <div class="reviews-summary">
          <div class="reviews-score">4.9</div>
          <div class="reviews-meta">
            <div class="stars">★★★★★</div>
            <p>{{ trans('home.reviews.count') }}</p>
          </div>
        </div>
      </div>
      <div class="reviews-grid">
        <article class="review-card">
          <div class="stars">★★★★★</div>
          <p class="review-quote">{{ trans('home.reviews.r1_q') }}</p>
          <div class="review-author"><span class="review-avatar">{{ trans('home.reviews.r1_i') }}</span><div><div class="review-name">{{ trans('home.reviews.r1_n') }}</div><div class="review-verified">{{ trans('home.reviews.verified') }}</div></div></div>
        </article>
        <article class="review-card">
          <div class="stars">★★★★★</div>
          <p class="review-quote">{{ trans('home.reviews.r2_q') }}</p>
          <div class="review-author"><span class="review-avatar">{{ trans('home.reviews.r2_i') }}</span><div><div class="review-name">{{ trans('home.reviews.r2_n') }}</div><div class="review-verified">{{ trans('home.reviews.verified') }}</div></div></div>
        </article>
        <article class="review-card">
          <div class="stars">★★★★★</div>
          <p class="review-quote">{{ trans('home.reviews.r3_q') }}</p>
          <div class="review-author"><span class="review-avatar">{{ trans('home.reviews.r3_i') }}</span><div><div class="review-name">{{ trans('home.reviews.r3_n') }}</div><div class="review-verified">{{ trans('home.reviews.verified') }}</div></div></div>
        </article>
      </div>
    </div>
  </section>

  {# شريط الشراء الثابت — يظهر على الجوال فقط #}
  {% set bp = store.products.featured|first %}
  <div class="buybar" data-buybar>
    <div class="buybar-info">
      <span class="buybar-name">Brightening Serum · 50ml</span>
      {% if bp.on_sale %}
        <span class="buybar-price">{{ bp.sale_price|money }} <span class="buybar-was">{{ bp.regular_price|money }}</span></span>
      {% else %}
        <span class="buybar-price">149 {{ trans('common.sar') }}</span>
      {% endif %}
    </div>
    {% if bp.id %}
      <salla-add-product-button
        product-id="{{ bp.id }}"
        product-status="{{ bp.status }}"
        product-type="{{ bp.type }}"
        class="btn btn-primary buybar-btn">
        {{ trans('home.hero.cta_short') }}
      </salla-add-product-button>
    {% else %}
      <a class="btn btn-primary buybar-btn" href="{{ url('products') }}">{{ trans('home.hero.cta_short') }}</a>
    {% endif %}
  </div>

{% endblock %}

{% block scripts %}
  <script src="{{ 'app.js' | asset }}" defer></script>
  <script src="{{ 'routine-tool.js' | asset }}" defer></script>
{% endblock %}
