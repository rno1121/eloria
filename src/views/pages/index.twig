</section>

{# ================================================================
   CTA SECTION
================================================================ #}
<section class="product-cta" id="product-cta" aria-label="اطلبي الآن">
    <div class="cta-bg-pattern" aria-hidden="true"></div>
    <div class="container">
        <div class="cta-inner" data-animate="fade-up">

            <span class="cta-eyebrow">{{ trans('pages.products.cta_eyebrow') }}</span>
            <h2 class="cta-title">
                {{ trans('pages.products.cta_title_line1') }}
                <em>{{ trans('pages.products.cta_title_accent') }}</em>
            </h2>
            <p class="cta-desc">{{ trans('pages.products.cta_desc') }}</p>

            <div class="cta-product-card">
                <div class="cta-product-image">
                    {% if product and product.image %}
                    <img src="{{ product.image.url }}" alt="{{ product.image.alt }}" loading="lazy" width="160" height="200">
                    {% else %}
                    <div class="cta-bottle-placeholder">
                        <span>ELORIA</span>
                        <small>Brightening<br>Body Serum</small>
                        <em>50ml</em>
                    </div>
                    {% endif %}
                </div>

                <div class="cta-product-info">
                    <h3 class="cta-product-name">Eloria Brightening Body Serum</h3>
                    <div class="cta-product-details">
                        <span class="detail-tag">50ml</span>
                        <span class="detail-tag">Niacinamide 10%</span>
