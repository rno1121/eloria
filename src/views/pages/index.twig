                    <svg width="16" height="16" viewBox="0 0 16 16" fill="var(--rose)"><path d="M8 1l1.8 3.7 4.1.6-3 2.9.7 4.1L8 10.4 4.4 12.3l.7-4.1-3-2.9 4.1-.6L8 1z"/></svg>
