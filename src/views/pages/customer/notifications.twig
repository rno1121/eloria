{#
  Eloria — Customer notifications
  src/views/pages/customer/notifications.twig
#}
{% extends 'layouts.master' %}

{% block content %}
{% embed 'components.customer.account-layout' with { active: 'notifications', title: trans('account.notifications') } %}
  {% block account_content %}
    <salla-notifications></salla-notifications>
    {% if notifications|length %}
      <ul class="notif-list">
        {% for note in notifications %}
          <li class="notif-item {{ note.is_read ? '' : 'is-unread' }}">
            <div class="notif-body">
              <strong>{{ note.title }}</strong>
              <p>{{ note.message }}</p>
            </div>
            <time>{{ note.created_at|date('Y/m/d') }}</time>
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <div class="account-empty"><p>{{ trans('account.notifications_empty') }}</p></div>
    {% endif %}
  {% endblock %}
{% endembed %}
{% endblock %}

{% block scripts %}
  <script src="{{ asset('js/app.js') }}" defer></script>
{% endblock %}
