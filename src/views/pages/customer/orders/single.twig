{#
  Eloria — Customer order single
  src/views/pages/customer/orders/single.twig
#}
{% extends 'layouts.master' %}

{% block content %}
{% embed 'components.customer.account-layout' with { active: 'orders', title: trans('account.order') ~ ' #' ~ order.id } %}
  {% block account_content %}
    <salla-order-details order-id="{{ order.id }}"></salla-order-details>
    <div class="order-back">
      <a href="{{ url('customer.orders') }}">← {{ trans('account.orders') }}</a>
    </div>
  {% endblock %}
{% endembed %}
{% endblock %}

{% block scripts %}
  <script src="{{ asset('js/app.js') }}" defer></script>
{% endblock %}
