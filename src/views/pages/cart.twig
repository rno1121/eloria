{#
  Eloria — Cart
  src/views/pages/cart.twig
#}
{% extends 'layouts.master' %}

{% block content %}
<section class="cart-page">
  <div class="container">
    <header class="cart-head">
      <span class="eyebrow">{{ trans('cart.eyebrow') }}</span>
      <h1 class="section-title">{{ trans('cart.title') }}</h1>
    </header>

    {% hook 'cart:items.start' %}
    <salla-cart-list></salla-cart-list>
    {% hook 'cart:items.end' %}

    {# مكوّنات سله المطلوبة للسلة #}
    <salla-cart-item-offers></salla-cart-item-offers>
    <salla-cart-coupons></salla-cart-coupons>
    <salla-conditional-offer></salla-conditional-offer>
    <salla-tiered-offer></salla-tiered-offer>
    <salla-loyalty-panel></salla-loyalty-panel>

    <div class="cart-actions">
      <a class="cart-continue" href="{{ url('products') }}">← {{ trans('cart.continue') }}</a>
    </div>

    <div class="cart-reassure">
      <div class="cart-reassure-item">{{ trans('product.shipping') }}</div>
      <div class="cart-reassure-item">{{ trans('product.secure') }}</div>
      <div class="cart-reassure-item">{{ trans('product.made') }}</div>
    </div>
  </div>
</section>
{% endblock %}

{% block scripts %}
  <script src="{{ asset('js/app.js') }}" defer></script>
{% endblock %}
