{#
  Eloria — Header
  src/views/components/header/header.twig
#}
<header class="site-header" id="site-header">
  <div class="announce-bar">
    <div class="container">
      <p>{{ theme.settings.get('announce_text') ?: trans('common.announce') }}</p>
    </div>
  </div>

  <div class="header-main">
    <div class="container header-grid">
      <button class="header-icon-btn nav-toggle" aria-label="{{ trans('common.menu') }}" data-nav-toggle>
        <span></span><span></span><span></span>
      </button>

      <a class="header-logo" href="{{ store.url }}">
        {% if store.logo %}
          <img src="{{ store.logo }}" alt="{{ store.name }}">
        {% else %}
          <span class="logo-wordmark">ELORIA</span>
        {% endif %}
      </a>

      <nav class="header-nav" aria-label="{{ trans('common.menu') }}">
        <a href="{{ store.url }}">{{ trans('nav.home') }}</a>
        <a href="{{ url('products') }}">{{ trans('nav.products') }}</a>
        <a href="#how-to-use">{{ trans('nav.how') }}</a>
        <a href="#routine">{{ trans('nav.routine') }}</a>
        <a href="{{ url('page', { slug: 'about-us' }) }}">{{ trans('nav.about') }}</a>
      </nav>

      <div class="header-actions">
        <a class="header-icon-btn" href="{{ url('customer.wishlist') }}" aria-label="{{ trans('nav.wishlist') }}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M12 20s-7-4.5-9.2-9C1.3 7.6 2.6 4.5 6 4.5c2 0 3.2 1.3 4 2.5.8-1.2 2-2.5 4-2.5 3.4 0 4.7 3.1 3.2 6.5C19 15.5 12 20 12 20z"/></svg>
        </a>
        <salla-cart-summary class="header-icon-btn" aria-label="{{ trans('nav.cart') }}"></salla-cart-summary>
        <a class="header-icon-btn" href="{{ url('customer.profile') }}" aria-label="{{ trans('nav.account') }}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="12" cy="8" r="3.5"/><path d="M5 20c0-3.5 3-6 7-6s7 2.5 7 6"/></svg>
        </a>
      </div>
    </div>
  </div>

  <nav class="mobile-nav" data-mobile-nav aria-label="{{ trans('common.menu') }}">
    <a href="{{ store.url }}">{{ trans('nav.home') }}</a>
    <a href="{{ url('products') }}">{{ trans('nav.products') }}</a>
    <a href="#how-to-use">{{ trans('nav.how') }}</a>
    <a href="#routine">{{ trans('nav.routine') }}</a>
    <a href="{{ url('page', { slug: 'about-us' }) }}">{{ trans('nav.about') }}</a>
  </nav>
  <div class="nav-overlay" data-nav-overlay></div>
</header>
