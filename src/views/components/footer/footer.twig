<footer class="eloria-footer">
    <div class="eloria-footer__top">
        <div class="container">
            <div class="eloria-footer__grid">

                {# Brand Column #}
                <div class="eloria-footer__brand">
                    <a href="{{ link('/') }}" class="eloria-footer__logo">
                        <img src="{{ store.logo|cdn(160) }}" alt="{{ store.name }}" width="120" height="48">
                    </a>
                    <p class="eloria-footer__tagline">بوستر سيروم تفتيح الجسم — نتائج واضحة خلال ١٤ يوماً</p>
                    <salla-social class="eloria-footer__social"></salla-social>
                </div>

                {# Quick Links #}
                <div class="eloria-footer__col">
                    <h4 class="eloria-footer__title">روابط سريعة</h4>
                    <ul class="eloria-footer__links">
                        <li><a href="{{ link('/') }}">الرئيسية</a></li>
                        <li><a href="/lvNPPDd">اطلبي الآن</a></li>
                        <li><a href="{{ link('/') }}#benefits">فوائد السيروم</a></li>
                        <li><a href="{{ link('/') }}#routine">الروتين</a></li>
                    </ul>
                </div>

                {# Contact #}
                <div class="eloria-footer__col">
                    <h4 class="eloria-footer__title">تواصلي معنا</h4>
                    <ul class="eloria-footer__links">
                        {% if store.phone %}
                        <li><a href="tel:{{ store.phone }}">{{ store.phone }}</a></li>
                        {% endif %}
                        {% if store.email %}
                        <li><a href="mailto:{{ store.email }}">{{ store.email }}</a></li>
                        {% endif %}
                        <li>الدعم متاح ٧ أيام</li>
                    </ul>
                </div>

                {# Trust #}
                <div class="eloria-footer__col">
                    <h4 class="eloria-footer__title">ضمانات التسوق</h4>
                    <ul class="eloria-footer__guarantees">
                        <li>✦ شحن مجاني لجميع المناطق</li>
                        <li>✦ إرجاع مجاني خلال ١٤ يوم</li>
                        <li>✦ دفع آمن ومشفر</li>
                        <li>✦ معتمد من هيئة الغذاء والدواء</li>
                    </ul>
                    <div class="eloria-footer__badges">
                        <salla-trust-badges dark></salla-trust-badges>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div class="eloria-footer__bottom">
        <div class="container">
            <div class="eloria-footer__bottom-inner">
                <span>© {{ "now"|date("Y") }} Eloria — جميع الحقوق محفوظة</span>
                <salla-payments></salla-payments>
            </div>
        </div>
    </div>
</footer>
