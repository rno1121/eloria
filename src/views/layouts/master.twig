<!DOCTYPE html>
<html lang="{{ app.locale }}" dir="{{ app.dir }}">
<head>
    {% hook 'head:start' %}

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#0D0D0D">

    <title>{% block title %}{{ store.name }}{% endblock %}</title>
    <meta name="description" content="{% block description %}Eloria Brightening Body Serum — نتائج واضحة خلال 14 يوم{% endblock %}">

    {# Canonical #}
    <link rel="canonical" href="{{ app.url }}">

    {# Fonts #}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Tajawal:wght@300;400;500;700&display=swap" rel="stylesheet">

    {# Theme Styles #}
    <link rel="stylesheet" href="{{ 'app.css' | asset }}">

    {% hook 'head' %}
    {% hook 'head:end' %}
</head>
<body class="eloria-theme {{ app.locale }}" data-dir="{{ app.dir }}">

    {% hook 'body:start' %}

    {# ===== HEADER ===== #}
    <header class="site-header" id="site-header">
        <div class="header-inner container">

            {# Logo #}
            <a href="{{ store.url }}" class="header-logo" aria-label="{{ store.name }}">
                <span class="logo-latin">ELORIA</span>
                <span class="logo-dot">·</span>
                <span class="logo-arabic">إيلوريا</span>
            </a>

            {# Nav #}
            <nav class="header-nav" aria-label="القائمة الرئيسية">
                <a href="{{ store.url }}">{{ trans('pages.home.title') }}</a>
                <a href="#benefits">{{ trans('pages.products.features') }}</a>
                <a href="#testimonials">{{ trans('pages.products.reviews') }}</a>
                <a href="#routine">{{ trans('pages.products.routine') }}</a>
            </nav>

            {# CTA #}
            <div class="header-actions">
                <a href="#product-cta" class="btn btn-primary btn-sm">
                    {{ trans('pages.products.order_now') }}
                </a>
                <button class="header-menu-toggle" id="menuToggle" aria-label="القائمة" aria-expanded="false">
                    <span></span><span></span><span></span>
                </button>
            </div>

        </div>

        {# Mobile Nav #}
        <div class="mobile-nav" id="mobileNav" aria-hidden="true">
            <a href="{{ store.url }}">{{ trans('pages.home.title') }}</a>
            <a href="#benefits">{{ trans('pages.products.features') }}</a>
            <a href="#testimonials">{{ trans('pages.products.reviews') }}</a>
            <a href="#routine">{{ trans('pages.products.routine') }}</a>
            <a href="#product-cta" class="btn btn-primary">{{ trans('pages.products.order_now') }}</a>
        </div>
    </header>

    {# ===== MAIN CONTENT ===== #}
    <main id="main-content">
        {% block content %}{% endblock %}
    </main>

    {# ===== FOOTER ===== #}
    <footer class="site-footer">
        <div class="footer-inner container">

            <div class="footer-brand">
                <a href="{{ store.url }}" class="footer-logo">
                    <span class="logo-latin">ELORIA</span>
                    <span class="logo-dot">·</span>
                    <span class="logo-arabic">إيلوريا</span>
                </a>
                <p class="footer-tagline">{{ trans('pages.products.tagline') }}</p>
            </div>

            <div class="footer-links">
                <h4>{{ trans('pages.general.links') }}</h4>
                <ul>
                    <li><a href="{{ store.url }}">{{ trans('pages.home.title') }}</a></li>
                    <li><a href="/privacy-policy">{{ trans('pages.general.privacy') }}</a></li>
                    <li><a href="/terms">{{ trans('pages.general.terms') }}</a></li>
                    <li><a href="/contact-us">{{ trans('pages.general.contact') }}</a></li>
                </ul>
            </div>

            <div class="footer-social">
                <h4>{{ trans('pages.general.follow_us') }}</h4>
                {% if store.social.whatsapp %}
                <a href="https://wa.me/{{ store.social.whatsapp }}" class="social-link" target="_blank" rel="noopener" aria-label="واتساب">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                </a>
                {% endif %}
                <a href="https://instagram.com" class="social-link" target="_blank" rel="noopener" aria-label="انستقرام">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                </a>
                <a href="https://tiktok.com" class="social-link" target="_blank" rel="noopener" aria-label="تيك توك">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.69a8.17 8.17 0 004.79 1.54V6.77a4.85 4.85 0 01-1.02-.08z"/></svg>
                </a>
            </div>

        </div>

        <div class="footer-bottom">
            <div class="container footer-bottom-inner">
                <p class="footer-copyright">© {{ "now"|date("Y") }} {{ store.name }}. {{ trans('pages.general.rights_reserved') }}</p>
                <div class="footer-payments">
                    {# مدى #}
                    <img src="{{ 'images/mada.svg' | asset }}" alt="مدى" width="40" loading="lazy">
                    {# Apple Pay #}
                    <img src="{{ 'images/apple-pay.svg' | asset }}" alt="Apple Pay" width="50" loading="lazy">
                    {# STC Pay #}
                    <img src="{{ 'images/stc-pay.svg' | asset }}" alt="STC Pay" width="45" loading="lazy">
                    {# تابي #}
                    <img src="{{ 'images/tabby.svg' | asset }}" alt="تابي" width="45" loading="lazy">
                </div>
            </div>
        </div>
    </footer>

    {# ===== STICKY MOBILE BAR ===== #}
    <div class="sticky-bar" id="stickyBar" aria-hidden="true">
        <div class="sticky-bar-price">
            <span class="sticky-price-amount">149</span>
            <span class="sticky-price-currency">{{ trans('pages.general.sar') }}</span>
        </div>
        <a href="#product-cta" class="btn btn-primary sticky-bar-btn">
            {{ trans('pages.products.order_now') }}
        </a>
    </div>

    {% hook 'body:end' %}

    {# Scripts #}
    <script defer src="{{ 'app.js' | asset }}"></script>
    <script defer src="{{ 'routine-tool.js' | asset }}"></script>

    <script>
    // Header scroll effect
    const header = document.getElementById('site-header');
    const stickyBar = document.getElementById('stickyBar');
    let lastScroll = 0;

    window.addEventListener('scroll', () => {
        const y = window.scrollY;
        header.classList.toggle('scrolled', y > 60);
        stickyBar.classList.toggle('visible', y > 500);
        header.classList.toggle('hide', y > lastScroll && y > 200);
        lastScroll = y;
    }, { passive: true });

    // Mobile menu
    const menuToggle = document.getElementById('menuToggle');
    const mobileNav = document.getElementById('mobileNav');
    menuToggle.addEventListener('click', () => {
        const open = mobileNav.classList.toggle('open');
        menuToggle.setAttribute('aria-expanded', open);
        mobileNav.setAttribute('aria-hidden', !open);
        document.body.classList.toggle('menu-open', open);
    });

    // Close mobile nav on link click
    mobileNav.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
            mobileNav.classList.remove('open');
            menuToggle.setAttribute('aria-expanded', false);
            mobileNav.setAttribute('aria-hidden', true);
            document.body.classList.remove('menu-open');
        });
    });
    </script>

</body>
</html>
